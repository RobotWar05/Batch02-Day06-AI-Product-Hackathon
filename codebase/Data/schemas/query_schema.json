{
  "version": 2,
  "required_fields": [
    "origin",
    "destination"
  ],
  "optional_fields": [
    "travel_date",
    "return_date",
    "trip_type",
    "transport_mode",
    "preferred_provider",
    "passengers",
    "priority",
    "sort_by"
  ],
  "defaults": {
    "trip_type": "one_way",
    "passengers": 1,
    "priority": "balanced",
    "sort_by": "recommended"
  },
  "trip_type_values": [
    "one_way",
    "round_trip"
  ],
  "transport_mode_values": [
    "flight",
    "train"
  ],
  "priority_values": [
    "cheap",
    "fast",
    "balanced",
    "premium"
  ],
  "provider_values": [
    "Vietnam Airlines",
    "Vietjet Air",
    "Bamboo Airways",
    "Vietravel Airlines",
    "Sun PhuQuoc Airways",
    "Vietnam Railways"
  ],
  "validation_rules": [
    "origin và destination phải khớp canonical_name hoặc alias trong metadata/locations.json",
    "travel_date là tùy chọn trong mock data và không được dùng làm hard filter",
    "transport_mode có thể để trống khi user muốn so sánh máy bay và tàu hỏa"
  ]
}
